<Sysmon schemaversion="4.82">
  <EventFiltering>
    <RuleGroup name="MedDefense Custom Detection Rules" groupRelation="or">
      <!-- Process Create Events (Event ID 1) -->
      <ProcessCreate onmatch="include">
        <!-- Rule 1: Detect Rclone Exfiltration Tool -->
        <Image name="Technique=Exfiltration,Tool=Rclone" condition="contains">rclone.exe</Image>
        
        <!-- Rule 3: Detect Encoded PowerShell Execution -->
        <CommandLine name="Technique=Execution,Tool=EncodedPowerShell" condition="contains">-enc</CommandLine>
        
        <!-- Rule 4: Detect Ransomware vssadmin Shadow Copy Deletion -->
        <CommandLine name="Technique=Impact,Tool=ShadowDeletion" condition="contains">vssadmin</CommandLine>

        <!-- Rule 5: Detect schtasks Scheduled Task Persistence Creation -->
        <CommandLine name="Technique=Persistence,Tool=schtasks" condition="contains">schtasks</CommandLine>
      </ProcessCreate>

      <!-- Registry Event Rules (Event ID 12, 13, 14) -->
      <RegistryEvent onmatch="include">
        <!-- Rule 2: Detect PsExec Service Installation -->
        <TargetObject name="Technique=LateralMovement,Tool=PsExec" condition="contains">PSEXESVC</TargetObject>
      </RegistryEvent>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
